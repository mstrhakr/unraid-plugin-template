{
    "name": "unraid/plugin-template",
    "description": "Template for creating Unraid plugins with testing support",
    "type": "project",
    "license": "Unlicense",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload-dev": {
        "psr-4": {
            "PluginName\\Tests\\": "tests/unit/",
            "PluginTests\\": "tests/framework/src/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test:coverage": "Run tests with HTML coverage report",
        "analyse": "Run PHPStan static analysis",
        "format": "Fix code style with PHP-CS-Fixer",
        "format:check": "Check code style without fixing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}